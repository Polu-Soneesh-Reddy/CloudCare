# ====================================================
# CloudCare Environment Configuration
# Copy to .env — NEVER commit .env to git
# ====================================================

# --- PostgreSQL ---
POSTGRES_DB=cloudcare
POSTGRES_USER=cloudcare
POSTGRES_PASSWORD=ChangeMeUseAStrongPassword123!

# --- Backend ---
DATABASE_URL=postgresql://cloudcare:ChangeMeUseAStrongPassword123!@postgres:5432/cloudcare
SECRET_KEY=changeme_generate_with_openssl_rand_hex_32
CORS_ORIGINS=http://localhost,http://localhost:80

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000

# --- Monitoring ---
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=cloudcare123

# --- AWS / EC2 (fill after terraform apply) ---
EC2_HOST=YOUR_EC2_PUBLIC_IP_HERE

# --- Docker Hub (for CI/CD) ---
DOCKERHUB_USERNAME=YOUR_DOCKERHUB_USERNAME
DOCKERHUB_REPO_BACKEND=cloudcare-backend
DOCKERHUB_REPO_FRONTEND=cloudcare-frontend
``
