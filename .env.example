# ====================================================
# CloudCare Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ====================================================

# --- PostgreSQL ---
POSTGRES_DB=cloudcare
POSTGRES_USER=cloudcare
POSTGRES_PASSWORD=changeme_use_a_strong_password
DATABASE_URL=postgresql://cloudcare:changeme_use_a_strong_password@postgres:5432/cloudcare

# --- Backend ---
SECRET_KEY=changeme_generate_with_openssl_rand_hex_32
CORS_ORIGINS=http://localhost:5173,http://localhost:80

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000

# --- Docker Hub (CI/CD only) ---
DOCKERHUB_USERNAME=YOUR_DOCKERHUB_USERNAME
DOCKERHUB_REPO_BACKEND=cloudcare-backend
DOCKERHUB_REPO_FRONTEND=cloudcare-frontend

# --- Kubernetes / EC2 (CI/CD only) ---
EC2_HOST=YOUR_EC2_PUBLIC_IP
EC2_USER=ubuntu
K8S_NAMESPACE=cloudcare
