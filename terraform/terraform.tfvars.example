# Copy to terraform.tfvars and fill in your values
# NEVER commit terraform.tfvars to git

aws_region      = "ap-south-1"
project_name    = "cloudcare"
instance_type   = "t3.medium"
public_key_path = "~/.ssh/cloudcare_key.pub"

# To use a different region, also update ami_id:
# us-east-1  → ami-0c7217cdde317cfec  (Ubuntu 22.04)
# us-west-2  → ami-04b4c3bde1960dfb7  (Ubuntu 22.04)
# eu-west-1  → ami-0d2a4a5d69e46ea0b  (Ubuntu 22.04)
# ap-south-1 → ami-0e35ddab05955cf57  (Ubuntu 22.04)
``
